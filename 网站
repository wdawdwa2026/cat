<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>visionOS · 空间控制台</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js">
    </script>

    <script type="importmap">
        {
            "imports": {
                "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
                "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
            }
        }
    </script>

    <style>
        /* ============================================================
           visionOS Spatial UI Design System — 舒适版
           ============================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #0a0a12;
            --text-primary: rgba(255, 255, 255, 0.92);
            --text-secondary: rgba(255, 255, 255, 0.55);
            --text-tertiary: rgba(255, 255, 255, 0.25);
            --glass-bg: rgba(255, 255, 255, 0.04);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
            --glass-blur: 50px;
            --accent: #6c5ce7;
            --accent-light: #8b5cf6;
            --radius-xl: 40px;
            --radius-lg: 28px;
            --radius-md: 18px;
            --radius-sm: 12px;
            --radius-full: 9999px;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
            --section-spacing: 80px;
        }

        @media (prefers-color-scheme: light) {
            :root {
                --bg: #eceff4;
                --text-primary: rgba(0, 0, 0, 0.88);
                --text-secondary: rgba(0, 0, 0, 0.5);
                --text-tertiary: rgba(0, 0, 0, 0.22);
                --glass-bg: rgba(255, 255, 255, 0.55);
                --glass-border: rgba(255, 255, 255, 0.4);
                --glass-shadow: 0 30px 80px rgba(0, 0, 0, 0.06);
            }
        }

        html {
            scroll-behavior: smooth;
        }
        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text-primary);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
            transition: background 0.6s ease, color 0.6s ease;
            min-height: 100vh;
        }

        /* ===== Three.js 背景 ===== */
        #three-container {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
        }
        #three-container canvas {
            display: block;
            width: 100% !important;
            height: 100% !important;
        }

        .content {
            position: relative;
            z-index: 2;
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 24px 60px;
        }

        /* ============================================================
           加载动画
           ============================================================ */
        #loader {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: var(--bg);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        #loader.hidden {
            opacity: 0;
            pointer-events: none;
            transform: scale(1.02);
        }
        .loader-ring {
            width: 56px;
            height: 56px;
            position: relative;
        }
        .loader-ring svg {
            width: 100%;
            height: 100%;
        }
        .loader-ring svg circle {
            fill: none;
            stroke: var(--accent);
            stroke-width: 2;
            stroke-linecap: round;
            stroke-dasharray: 120;
            stroke-dashoffset: 40;
            animation: loaderDash 1.2s ease-in-out infinite alternate;
        }
        @keyframes loaderDash {
            0% {
                stroke-dashoffset: 120;
            }
            100% {
                stroke-dashoffset: 0;
            }
        }
        .loader-status {
            margin-top: 24px;
            font-size: 13px;
            color: var(--text-secondary);
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 400;
        }
        .loader-progress {
            margin-top: 12px;
            width: 160px;
            height: 2px;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 4px;
            overflow: hidden;
        }
        .loader-progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--accent), var(--accent-light));
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        /* ============================================================
           导航栏
           ============================================================ */
        .navbar {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            background: var(--glass-bg);
            backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
            -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-full);
            padding: 10px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            box-shadow: var(--glass-shadow);
            width: auto;
            max-width: 90%;
            min-width: 320px;
            transition: background 0.3s, border-color 0.3s;
        }
        .navbar-brand {
            font-weight: 600;
            font-size: 16px;
            letter-spacing: -0.2px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-primary);
        }
        .navbar-brand .brand-icon {
            font-size: 20px;
        }
        .navbar-brand .brand-text {
            background: linear-gradient(135deg, #f0f4ff, #b8c6ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .navbar-badge {
            font-size: 11px;
            padding: 4px 14px;
            border-radius: var(--radius-full);
            background: rgba(108, 92, 231, 0.10);
            color: var(--accent-light);
            border: 1px solid rgba(108, 92, 231, 0.06);
            font-weight: 500;
            letter-spacing: 0.3px;
        }
        .theme-toggle {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 18px;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: var(--radius-sm);
            transition: all 0.3s ease;
        }
        .theme-toggle:hover {
            background: var(--glass-bg);
            color: var(--text-primary);
        }

        /* ============================================================
           Toast — Dynamic Island 风格
           ============================================================ */
        .toast-container {
            position: fixed;
            top: 80px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9998;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }
        .toast {
            padding: 12px 28px;
            border-radius: var(--radius-full);
            background: var(--glass-bg);
            backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
            -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
            border: 1px solid var(--glass-border);
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 500;
            box-shadow: var(--glass-shadow);
            pointer-events: auto;
            opacity: 0;
            transform: translateY(-16px) scale(0.94);
            transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .toast.show {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        .toast.success {
            border-color: rgba(52, 211, 153, 0.15);
            color: #34d399;
        }
        .toast.error {
            border-color: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        /* ============================================================
           3D 文字系统 — 视觉立体，不晃动
           ============================================================ */
        .text-3d {
            display: inline-block;
            font-weight: 700;
            letter-spacing: -0.02em;
            position: relative;
            background: linear-gradient(165deg, #f0f4ff 0%, #b8c6ff 35%, #8b9fd0 65%, #b8c6ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow:
                0 1px 0 rgba(255, 255, 255, 0.20),
                0 2px 0 rgba(255, 255, 255, 0.14),
                0 3px 0 rgba(255, 255, 255, 0.08),
                0 4px 0 rgba(255, 255, 255, 0.04),
                0 6px 0 rgba(0, 0, 0, 0.04),
                0 8px 0 rgba(0, 0, 0, 0.06),
                0 10px 12px rgba(0, 0, 0, 0.18),
                0 14px 28px rgba(0, 0, 0, 0.12);
            transition: transform 0.05s ease;
        }
        .text-3d::before {
            content: '';
            position: absolute;
            top: -8px;
            left: -5%;
            width: 110%;
            height: 35%;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, transparent 100%);
            pointer-events: none;
            border-radius: 50%;
            filter: blur(8px);
            opacity: 0.7;
        }
        .text-3d::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: -5%;
            width: 110%;
            height: 20%;
            background: linear-gradient(0deg, rgba(139, 92, 246, 0.10) 0%, transparent 100%);
            pointer-events: none;
            border-radius: 50%;
            filter: blur(10px);
            opacity: 0.5;
        }

        .hero h1 .text-3d {
            font-size: clamp(40px, 6.5vw, 58px);
            text-shadow:
                0 1px 0 rgba(255, 255, 255, 0.20),
                0 2px 0 rgba(255, 255, 255, 0.14),
                0 4px 0 rgba(255, 255, 255, 0.08),
                0 6px 0 rgba(255, 255, 255, 0.04),
                0 8px 0 rgba(0, 0, 0, 0.04),
                0 10px 0 rgba(0, 0, 0, 0.06),
                0 12px 16px rgba(0, 0, 0, 0.22),
                0 18px 36px rgba(0, 0, 0, 0.14);
        }
        .section-title .text-3d {
            font-size: clamp(32px, 4.5vw, 46px);
        }
        .glass-card-sm h3 .text-3d {
            font-size: 20px;
            text-shadow:
                0 1px 0 rgba(255, 255, 255, 0.16),
                0 2px 0 rgba(255, 255, 255, 0.08),
                0 3px 0 rgba(255, 255, 255, 0.04),
                0 5px 8px rgba(0, 0, 0, 0.14);
        }

        /* ============================================================
           Section
           ============================================================ */
        section {
            padding: var(--section-spacing) 0;
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        section.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .section-desc {
            color: var(--text-secondary);
            font-size: 18px;
            max-width: 600px;
            margin-bottom: 40px;
            line-height: 1.7;
            font-weight: 400;
        }

        /* ============================================================
           Hero
           ============================================================ */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 120px 0 60px;
            text-align: center;
        }
        .hero .glass-card {
            max-width: 660px;
            width: 100%;
            background: var(--glass-bg);
            backdrop-filter: blur(var(--glass-blur)) saturate(1.6);
            -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.6);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-xl);
            padding: 52px 44px 40px;
            box-shadow: var(--glass-shadow), inset 0 0 0 1px rgba(255, 255, 255, 0.02);
            position: relative;
            transition: transform 0.4s ease, box-shadow 0.4s ease;
            will-change: transform;
            margin: 0 auto;
        }
        .hero .glass-card::before {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: calc(var(--radius-xl) + 2px);
            padding: 2px;
            background: conic-gradient(from 0deg,
                    transparent,
                    rgba(108, 92, 231, 0.12),
                    transparent,
                    rgba(0, 212, 255, 0.06),
                    transparent);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            opacity: 0.4;
            animation: borderRotate 12s linear infinite;
        }
        @keyframes borderRotate {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }
        .hero .card-highlight {
            position: absolute;
            inset: 0;
            border-radius: var(--radius-xl);
            pointer-events: none;
            background: radial-gradient(circle at var(--hl-x, 50%) var(--hl-y, 50%),
                    rgba(255, 255, 255, 0.02) 0%,
                    transparent 60%);
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        .hero .glass-card:hover .card-highlight {
            opacity: 1;
        }
        .hero .sub {
            color: var(--text-secondary);
            font-size: 18px;
            margin-bottom: 28px;
            line-height: 1.6;
            font-weight: 400;
            letter-spacing: 0.2px;
        }

        .hero .code-block {
            background: rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(10px);
            border-radius: var(--radius-md);
            padding: 18px 22px;
            font-family: 'SF Mono', 'JetBrains Mono', monospace;
            font-size: 14px;
            color: #b8c6ff;
            word-break: break-all;
            line-height: 1.8;
            border: 1px solid var(--glass-border);
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 28px;
            user-select: all;
            text-align: left;
            box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.15);
        }
        .hero .code-block:hover {
            border-color: rgba(108, 92, 231, 0.2);
            box-shadow: 0 0 40px rgba(108, 92, 231, 0.03), inset 0 0 30px rgba(0, 0, 0, 0.2);
        }

        /* ============================================================
           玻璃按钮
           ============================================================ */
        .btn-glass {
            display: inline-block;
            padding: 16px 48px;
            border: none;
            border-radius: var(--radius-full);
            font-family: var(--font);
            font-weight: 600;
            font-size: 18px;
            cursor: pointer;
            width: 100%;
            position: relative;
            background: linear-gradient(165deg, rgba(108, 92, 231, 0.85), rgba(139, 92, 246, 0.75));
            color: #fff;
            box-shadow:
                0 8px 32px rgba(108, 92, 231, 0.20),
                inset 0 1px 0 rgba(255, 255, 255, 0.12),
                inset 0 -2px 8px rgba(30, 20, 60, 0.2);
            transition: transform 0.15s ease, box-shadow 0.3s ease;
            text-shadow: 0 1px 8px rgba(0, 0, 0, 0.12);
            letter-spacing: 0.2px;
            overflow: hidden;
        }
        .btn-glass .btn-content {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .btn-glass::before {
            content: '';
            position: absolute;
            top: 2px;
            left: 8%;
            width: 84%;
            height: 38%;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
            pointer-events: none;
            z-index: 1;
        }
        .btn-glass::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 8%;
            width: 84%;
            height: 10px;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(76, 59, 168, 0.12) 0%, transparent 70%);
            pointer-events: none;
            filter: blur(4px);
        }
        .btn-glass .btn-shimmer {
            position: absolute;
            top: 0;
            left: -100%;
            width: 300%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);
            transform: skewX(-20deg);
            transition: left 0.8s ease;
            pointer-events: none;
            z-index: 0;
        }
        .btn-glass:hover .btn-shimmer {
            left: 100%;
        }
        .btn-glass:hover {
            transform: translateY(-2px) scale(1.01);
            box-shadow: 0 12px 48px rgba(108, 92, 231, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        }
        .btn-glass:active {
            transform: scale(0.98);
            transition-duration: 0.05s;
        }
        .btn-glass.success {
            background: linear-gradient(165deg, rgba(52, 211, 153, 0.85), rgba(16, 185, 129, 0.75));
            box-shadow: 0 8px 32px rgba(52, 211, 153, 0.20), inset 0 1px 0 rgba(255, 255, 255, 0.12);
        }

        .hero .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--glass-border);
            font-size: 13px;
            color: var(--text-secondary);
            flex-wrap: wrap;
            gap: 12px;
        }
        .hero .status-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 400;
        }
        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }
        .status-dot.green {
            background: #34d399;
            box-shadow: 0 0 8px rgba(52, 211, 153, 0.3);
        }
        .status-dot.yellow {
            background: #fbbf24;
            box-shadow: 0 0 8px rgba(251, 191, 36, 0.3);
        }
        .status-dot.off {
            background: #4e5e7a;
        }

        /* ============================================================
           卡片网格
           ============================================================ */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
        }
        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }
        .grid-4 {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .glass-card-sm {
            background: var(--glass-bg);
            backdrop-filter: blur(24px) saturate(1.4);
            -webkit-backdrop-filter: blur(24px) saturate(1.4);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 32px 28px;
            box-shadow: var(--glass-shadow), inset 0 0 0 1px rgba(255, 255, 255, 0.01);
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
            position: relative;
            overflow: hidden;
        }
        .glass-card-sm::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at var(--glow-x, 50%) var(--glow-y, 50%),
                    rgba(255, 255, 255, 0.02) 0%,
                    transparent 60%);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        .glass-card-sm:hover::before {
            opacity: 1;
        }
        .glass-card-sm:hover {
            transform: translateY(-4px) scale(1.01);
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.25), 0 0 40px rgba(108, 92, 231, 0.02);
        }
        .glass-card-sm .icon {
            font-size: 30px;
            margin-bottom: 12px;
            display: block;
            filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.15));
        }
        .glass-card-sm h3 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 6px;
        }
        .glass-card-sm p {
            color: var(--text-secondary);
            font-size: 15px;
            line-height: 1.6;
            font-weight: 400;
        }
        .feature-tag {
            display: inline-block;
            background: rgba(108, 92, 231, 0.08);
            color: var(--accent-light);
            padding: 2px 14px;
            border-radius: var(--radius-full);
            font-size: 12px;
            font-weight: 500;
            border: 1px solid rgba(108, 92, 231, 0.04);
            margin-top: 10px;
        }

        /* ============================================================
           系统状态
           ============================================================ */
        .status-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 20px;
            background: var(--glass-bg);
            backdrop-filter: blur(24px);
            border-radius: var(--radius-lg);
            padding: 32px;
            border: 1px solid var(--glass-border);
        }
        .status-item-large {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }
        .status-item-large .label {
            font-size: 13px;
            color: var(--text-tertiary);
            font-weight: 400;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .status-item-large .value {
            font-size: 18px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-primary);
        }

        /* ============================================================
           版本信息
           ============================================================ */
        .version-info {
            text-align: center;
            padding: 40px 0 20px;
            border-top: 1px solid var(--glass-border);
            color: var(--text-tertiary);
            font-size: 14px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .version-info .tech-stack {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .version-info .tech-stack span {
            background: var(--glass-bg);
            padding: 4px 16px;
            border-radius: var(--radius-full);
            border: 1px solid var(--glass-border);
            font-size: 12px;
        }

        /* ============================================================
           响应式
           ============================================================ */
        @media (max-width: 768px) {
            .grid-2,
            .grid-3,
            .grid-4 {
                grid-template-columns: 1fr;
            }
            .hero .glass-card {
                padding: 32px 24px 28px;
                border-radius: var(--radius-lg);
            }
            .navbar {
                padding: 8px 18px;
                min-width: auto;
                top: 14px;
                border-radius: 60px;
            }
            .navbar-brand {
                font-size: 14px;
            }
            .navbar-badge {
                font-size: 10px;
                padding: 2px 10px;
            }
